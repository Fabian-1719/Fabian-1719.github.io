---
/* A technology's official logo. Black marks get the "logo--dark" class so dark panels can lighten them. */
import { logoFor } from "../data/logos";
interface Props { name: string; class?: string }
const { name, class: cls } = Astro.props;
const logo = logoFor(name);
---
{logo && <img class:list={[cls, { "logo--dark": logo.dark }]} src={logo.src} alt="" width="24" height="24" decoding="async" />}
