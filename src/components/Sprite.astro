---
/* A pixel sprite from rows of characters: each character is one pixel, "." is empty.
   Runs of the same colour on a row become one rect, so the SVG stays small and crisp. */
interface Props { rows: string[]; colors: Record<string, string>; class?: string }
const { rows, colors, class: cls } = Astro.props;
const w = rows[0].length, h = rows.length;
const rects: { x: number; y: number; w: number; c: string }[] = [];
rows.forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const ch = row[x];
    let e = x + 1;
    while (e < row.length && row[e] === ch) e++;
    if (colors[ch]) rects.push({ x, y, w: e - x, c: colors[ch] });
    x = e;
  }
});
---
<svg class={cls} viewBox={`0 0 ${w} ${h}`} width={w} height={h} shape-rendering="crispEdges" aria-hidden="true">
  {rects.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.c} />)}
</svg>
