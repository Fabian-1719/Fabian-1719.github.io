---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import { UI } from "../i18n";
import { projects } from "../data/projects";
import { bags } from "../data/inventory";
const pad = (n: number) => String(n).padStart(2, "0");
---
<Base
  title={{ en: "Fabian Aragón Arce · Computer Engineering student", es: "Fabian Aragón Arce · Estudiante de Ingeniería en Computación" }}
  description="Portfolio of Fabian Aragón Arce, Computer Engineering student at Instituto Tecnológico de Costa Rica: distributed systems and full-stack projects."
>
  <section class="scene scene--hero" id="top">
    <div class="panel hero">
      <p class="lbl" data-es={UI.heroLabel.es}>{UI.heroLabel.en}</p>
      <h1 class="hero__name">Fabian Aragón Arce</h1>
      <p class="big" data-es={UI.heroLede.es}>{UI.heroLede.en}</p>
      <div class="actions">
        <a class="btn" href="#projects"><span data-es={UI.heroCta.es}>{UI.heroCta.en}</span> <span aria-hidden="true">↓</span></a>
        <span class="soon" role="note" aria-label={UI.cvSoon.en} data-es-label={UI.cvSoon.es}>{UI.cv.en}<em data-es={UI.soon.es}>{UI.soon.en}</em></span>
      </div>
    </div>
  </section>

  <section class="scene" id="about" aria-labelledby="about-title">
    <div class="panel">
      <p class="lbl" data-es={UI.aboutLabel.es}>{UI.aboutLabel.en}</p>
      <h2 id="about-title" data-es={UI.aboutTitle.es}>{UI.aboutTitle.en}</h2>
      <p class="body" data-es={UI.aboutP.es}>{UI.aboutP.en}</p>
      <dl class="facts">
        <div><dt data-es={UI.factStudy.es}>{UI.factStudy.en}</dt><dd data-es={UI.factStudyV.es}>{UI.factStudyV.en}</dd></div>
        <div><dt data-es={UI.factFocus.es}>{UI.factFocus.en}</dt><dd data-es={UI.factFocusV.es}>{UI.factFocusV.en}</dd></div>
        <div><dt data-es={UI.factLang.es}>{UI.factLang.en}</dt><dd data-es={UI.factLangV.es}>{UI.factLangV.en}</dd></div>
      </dl>
    </div>
  </section>

  <section class="scene" id="projects" aria-labelledby="projects-title">
    <div class="panel panel--wide">
      <p class="lbl" data-es={UI.projectsLabel.es}>{UI.projectsLabel.en}</p>
      <h2 id="projects-title" data-es={UI.projectsTitle.es}>{UI.projectsTitle.en}</h2>
      <ol class="projects">
        {projects.map((p, i) => (
          <li class="proj" id={p.slug}>
            <span class="proj__num" aria-hidden="true">{pad(i + 1)}</span>
            <div class="proj__body">
              <h3><a class="proj__title" href={`/projects/${p.slug}/`}>{p.title}</a></h3>
              <p class="proj__meta" data-es={p.who.es}>{p.who.en}</p>
              <p data-es={p.blurb.es}>{p.blurb.en}</p>
              <ul class="stack" aria-label="Stack">{p.stack.map((t) => <li><Logo class="stack__logo" name={t} />{t}</li>)}</ul>
              <p class="proj__links">
                <a class="link" href={`/projects/${p.slug}/`} data-es={UI.more.es}>{UI.more.en}</a>
                {p.live && <a class="link" href={p.live} rel="noopener" data-es={UI.live.es}>{UI.live.en}</a>}
                {p.code.map((c) => c.label
                  ? <a class="link" href={c.href} rel="noopener">{c.label}</a>
                  : <a class="link" href={c.href} rel="noopener" data-es={UI.code.es}>{UI.code.en}</a>)}
                {p.private && <span class="muted" data-es={UI.private.es}>{UI.private.en}</span>}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="scene" id="stack" aria-labelledby="stack-title">
    <div class="panel panel--wide">
      <p class="lbl" data-es={UI.stackLabel.es}>{UI.stackLabel.en}</p>
      <h2 id="stack-title" data-es={UI.stackTitle.es}>{UI.stackTitle.en}</h2>
      <dl class="skills">
        {bags.map((b) => (
          <div>
            <dt data-es={b.label.es}>{b.label.en}</dt>
            <dd><ul class="stack stack--big">{b.items.map((it) => <li><Logo class="stack__logo" name={it.name} />{it.name}</li>)}</ul></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="scene scene--end" id="contact" aria-labelledby="contact-title">
    <div class="panel">
      <p class="lbl" data-es={UI.contactLabel.es}>{UI.contactLabel.en}</p>
      <h2 id="contact-title" data-es={UI.contactTitle.es}>{UI.contactTitle.en}</h2>
      <p class="body" data-es={UI.contactLede.es}>{UI.contactLede.en}</p>
      <div class="actions">
        <a class="btn" href="mailto:fabsarceargon@gmail.com">fabsarceargon@gmail.com</a>
        <a class="link" href="https://www.linkedin.com/in/fabian-arce-570038402" rel="noopener">LinkedIn</a>
        <a class="link" href="https://github.com/Fabian-1719" rel="noopener">GitHub</a>
      </div>
    </div>
  </section>
</Base>
